<?xml version="1.0" encoding="utf-8"?>
<!--
    Locale config for Android 13 per-app language preferences. Alcedo ships
    with English and Simplified Chinese; the system uses this file to expose
    the choice in Settings > System > Languages > App languages.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-CN" />
</locale-config>
