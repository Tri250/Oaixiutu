<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="projects" />
        <exclude domain="sharedpref" path="alcedo_ai_creds.xml" />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="thumbnails" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="projects" />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="thumbnails" />
    </device-transfer>
</data-extraction-rules>
