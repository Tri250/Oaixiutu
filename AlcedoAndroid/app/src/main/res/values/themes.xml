<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlcedoStudio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AlcedoStudio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/alcedo_dark_background</item>
        <!-- Use the foreground vector drawable directly — adaptive icons may fail
             to inflate inside SplashScreen on some OEM Android 9-11 ROMs -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.AlcedoStudio</item>
    </style>
</resources>
