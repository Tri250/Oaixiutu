<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data-extraction rules. The same policy as backup_rules applies:
    keep DB + prefs + sidecars on device-to-device transfer, drop caches and
    model artifacts.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="alcedo.db" />
        <include domain="sharedpref" path="alcedo_prefs.xml" />
        <include domain="file" path="sidecars/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="alcedo.db" />
        <include domain="sharedpref" path="alcedo_prefs.xml" />
        <include domain="file" path="sidecars/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
